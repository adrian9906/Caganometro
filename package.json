{
  "name": "caganometro",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "corepack pnpm --parallel --filter client --filter server dev",
    "dev:client": "corepack pnpm --filter client dev",
    "dev:server": "corepack pnpm --filter server dev",
    "build": "corepack pnpm -r build",
    "type-check": "corepack pnpm -r type-check",
    "db:generate": "corepack pnpm --filter server db:generate",
    "db:migrate": "corepack pnpm --filter server db:migrate",
    "db:studio": "corepack pnpm --filter server db:studio"
  },
  "packageManager": "pnpm@10.14.0"
}
