generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                Int         @id @default(autoincrement())
  username          String      @unique @db.VarChar(30)
  passwordHash      String      @map("password_hash") @db.VarChar(255)
  activeCharacterId Int?        @map("active_character_id")
  fechaCreacion     DateTime    @default(now()) @map("fecha_creacion")
  characters        Character[]

  @@map("accounts")
}

model Character {
  id             Int              @id @default(autoincrement())
  accountId      Int              @map("account_id")
  nombre         String           @db.VarChar(40)
  nickname       String           @db.VarChar(24)
  descripcion    String           @db.VarChar(220)
  habilidades    String           @db.VarChar(180)
  fortalezas     String           @db.VarChar(180)
  debilidades    String           @db.VarChar(180)
  edad           Int
  estatura       Float
  colorPelo      String           @map("color_pelo") @db.VarChar(20)
  colorPiel      String           @map("color_piel") @db.VarChar(7)
  colorActual    String           @map("color_actual") @db.VarChar(7)
  totalCacas     Int              @default(0) @map("total_cacas")
  tamano         Float            @default(1.0)
  fuerza         Int              @default(5)
  ultimaCaca     DateTime?        @map("ultima_caca")
  fechaCreacion  DateTime         @default(now()) @map("fecha_creacion")
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  historialCacas HistorialCaca[]

  @@index([accountId])
  @@index([totalCacas(sort: Desc), fuerza(sort: Desc), fechaCreacion])
  @@map("characters")
}

model HistorialCaca {
  id           Int       @id @default(autoincrement())
  personajeId Int       @map("personaje_id")
  fechaHora    DateTime  @default(now()) @map("fecha_hora")
  tamanoAntes  Float     @map("tamano_antes")
  fuerzaAntes  Int       @map("fuerza_antes")
  colorAntes   String    @map("color_antes") @db.VarChar(7)
  personaje    Character @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  @@index([personajeId])
  @@map("historial_cacas")
}
